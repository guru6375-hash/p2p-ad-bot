# P2P advertisement manager - configuration template.
#
# Copy this file to `.env` (gitignored) and replace every placeholder.
# Precedence: process environment > this file. Values are never interpolated, and
# surrounding quotes are optional (`KEY="value"` and `KEY=value` are identical).
# A leading `export ` is tolerated, so the file can also be `source`d.

# --- Telegram ---------------------------------------------------------------
# BotFather token. Required for `python run.py bot`.
TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_BOTFATHER_TOKEN
# Integer Telegram user id of the ONLY operator allowed to talk to the bot.
TELEGRAM_OWNER_ID=123456789
# Optional Bot API base URL override (tests point this at a local stub).
TELEGRAM_API_BASE=https://api.telegram.org

# --- Runtime state (relative paths are resolved against the working directory) ----
STATE_PATH=var/state.json
MARKET_PATH=var/market.json
ADS_PATH=var/ads.json
SCENARIOS_DIR=scenarios
# Empty value = log to the console only.
LOG_PATH=var/bot.log
LOG_LEVEL=INFO

# --- Optional switches (read by p2pbot/services.py, not interpreted here) ----------
# Scenario activated at startup (a name from SCENARIOS_DIR, e.g. `uah` or `uah.json`).
# SCENARIO=uah
# Periodic price refresh in minutes: recompute + publish even without a new market
# snapshot. Leave it empty or 0 to disable periodic refreshes.
# REFRESH_INTERVAL_MINUTES=10

# --- Venue accounts ---------------------------------------------------------
# Accounts are discovered generically from keys shaped
#   <PLATFORM>_<INDEX>_<FIELD>
# e.g. BINANCE_1_API_KEY -> account "Binance#1", field API_KEY. The field name is
# stored uppercase and resolved case-insensitively.
#
# Required credentials per platform:
#   binance : API_KEY, SECRET_KEY
#   okx     : API_KEY, SECRET_KEY, PASSPHRASE
#   bybit   : API_KEY, SECRET_KEY
#
# SESSION-BASED CREDENTIALS: P2P advertisement management (create/update/pause of your
# own ads) is driven by the venue's p2p web session, not by the API key alone. When the
# venue asks for it, supply the session cookie and CSRF token of a logged-in p2p session:
#   binance : SESSION_COOKIE, CSRF_TOKEN
#   okx     : SESSION_COOKIE, CSRF_TOKEN
#   bybit   : not required (API key/secret only)
# These optional fields are only needed by the flows that manage ads; the public
# competitor parser works without them.

BINANCE_1_API_KEY=REPLACE_WITH_BINANCE_ACCOUNT_1_API_KEY
BINANCE_1_SECRET_KEY=REPLACE_WITH_BINANCE_ACCOUNT_1_SECRET_KEY
BINANCE_1_SESSION_COOKIE=REPLACE_WITH_BINANCE_ACCOUNT_1_P2P_SESSION_COOKIE
BINANCE_1_CSRF_TOKEN=REPLACE_WITH_BINANCE_ACCOUNT_1_CSRF_TOKEN

BINANCE_2_API_KEY=REPLACE_WITH_BINANCE_ACCOUNT_2_API_KEY
BINANCE_2_SECRET_KEY=REPLACE_WITH_BINANCE_ACCOUNT_2_SECRET_KEY
BINANCE_2_SESSION_COOKIE=REPLACE_WITH_BINANCE_ACCOUNT_2_P2P_SESSION_COOKIE
BINANCE_2_CSRF_TOKEN=REPLACE_WITH_BINANCE_ACCOUNT_2_CSRF_TOKEN

OKX_1_API_KEY=REPLACE_WITH_OKX_ACCOUNT_1_API_KEY
OKX_1_SECRET_KEY=REPLACE_WITH_OKX_ACCOUNT_1_SECRET_KEY
OKX_1_PASSPHRASE=REPLACE_WITH_OKX_ACCOUNT_1_PASSPHRASE
OKX_1_SESSION_COOKIE=REPLACE_WITH_OKX_ACCOUNT_1_P2P_SESSION_COOKIE
OKX_1_CSRF_TOKEN=REPLACE_WITH_OKX_ACCOUNT_1_CSRF_TOKEN

BYBIT_1_API_KEY=REPLACE_WITH_BYBIT_ACCOUNT_1_API_KEY
BYBIT_1_SECRET_KEY=REPLACE_WITH_BYBIT_ACCOUNT_1_SECRET_KEY
