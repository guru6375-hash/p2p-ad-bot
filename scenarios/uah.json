      "max_amount": "200000",
      "payment_methods": ["Monobank", "PrivatBank"],
      "price_offset": "0",
      "enabled": true
    },
    {
      "pair": "UAH/USDC",
      "anchor": false,
      "accounts": ["Binance#1", "Binance#2", "Okx#1", "Bybit#1"],
      "min_amount": "1000",
      "max_amount": "200000",
      "payment_methods": ["Monobank", "PrivatBank"],
